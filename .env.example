# AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
# 실사용자 영상은 결제가 연결된 유료 프로젝트에서만 처리합니다.
GEMINI_PAID_SERVICE_ACKNOWLEDGED=false
GEMINI_HTTP_TIMEOUT_MS=120000
YOUTUBE_RECOMMENDATIONS_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_WHITELIST_CHANNEL_IDS=

# 공개 주소와 개인정보 문의 연락처(운영 환경 필수)
PUBLIC_APP_ORIGIN=http://localhost:3001
PRIVACY_CONTACT_EMAIL=

# 비공개 파일럿 접근. 원문 코드는 저장하지 않고 SHA-256 값만 등록합니다.
PILOT_ACCESS_REQUIRED=false
PILOT_ACCESS_CODE_SHA256=

# 사용자 소유권 쿠키와 로컬 업로드 서명. 각각 32바이트 이상의 무작위 값 권장.
SESSION_SECRET=replace_with_a_long_random_secret
STORAGE_SIGNING_SECRET=replace_with_another_long_random_secret

# Railway PostgreSQL. 로컬에서 비워두면 ./data/pglite를 사용합니다.
DATABASE_URL=
PG_POOL_MAX=10
PG_SSL=disable
PGLITE_DATA_DIR=./data/pglite

# Railway Redis/BullMQ. 로컬에서 비워두면 앱 프로세스 안에서 작업을 실행합니다.
REDIS_URL=
QUEUE_MODE=inline
WORKER_CONCURRENCY=1
WORKER_LOCK_DURATION_MS=600000
ANALYSIS_JOB_TIMEOUT_MINUTES=45
FFMPEG_PATH=ffmpeg
REQUIRE_LGPL_FFMPEG=true
FFMPEG_FRAME_TIMEOUT_MS=45000
FFMPEG_MOTION_TIMEOUT_MS=120000

# Railway private Storage Bucket(S3 호환). 로컬에서는 ./data/local-bucket 사용.
STORAGE_MODE=local
BUCKET_ENDPOINT=
BUCKET_REGION=auto
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# 최신 Railway Bucket은 virtual URL 방식이 기본입니다. 구형 Bucket만 true로 변경하세요.
BUCKET_FORCE_PATH_STYLE=false
LOCAL_BUCKET_DIR=./data/local-bucket

# Railway Bucket의 자동 주입 이름도 그대로 지원합니다.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_S3_URL_STYLE=virtual

# 업로드·요청 방어
MAX_UPLOAD_FILE_BYTES=83886080
MAX_UPLOAD_TOTAL_BYTES=251658240
MAX_VIDEO_DURATION_SECONDS=45
MAX_VIDEO_PIXELS=8294400
UPLOAD_REQUESTS_PER_MINUTE=6
ANALYSIS_REQUESTS_PER_HOUR=12
VIDEO_RETENTION_DAYS=30
