# Google Gemini API
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델 (기본: gemini-3.1-flash-lite)
# 비전 + 비디오 입력을 지원하는 멀티모달 모델을 사용해야 함
GEMINI_MODEL=gemini-3.1-flash-lite

# SQLite 파일 경로 (프로젝트 루트 기준)
SQLITE_PATH=./data/golf-lesson.db

# 업로드 영상 임시 저장 경로
UPLOAD_DIR=./uploads

# YouTube Data API v3 (선택 사항 — 추천 영상 기능)
# https://console.cloud.google.com/apis/credentials 에서 발급
# 미설정 시 분석은 정상 동작, 추천 영상 섹션만 숨겨짐
YOUTUBE_API_KEY=

# 화이트리스트 채널 ID (선택, 쉼표로 구분)
# 채널 페이지 → 페이지 소스 보기 → "channelId" 검색하면 UCxxxxxxxx 형식의 ID 확인 가능
# 코드에 박혀있는 채널 이름 키워드(SBS골프, JTBC골프 등)에 추가로 우선 표시할 채널
YOUTUBE_WHITELIST_CHANNEL_IDS=
